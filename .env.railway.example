# ==============================================================================
# Fussion Backend - Railway Environment Variables Reference
#
# Paste these variables into your Railway Backend Service -> Variables tab.
# Variables prefixed with ${{...}} are Railway Reference Variables.
# ==============================================================================

# --- Mandatory Core & Database ---
APP_ENV=production
APP_NAME=fussion-backend
APP_VERSION=0.1.0

# Automatically references the Railway Postgres plugin attached to this project.
# The backend auto-normalizes postgresql:// to postgresql+psycopg:// at runtime.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Mandatory Production Security Keys ---
# Generate fresh keys using: python backend/scripts/generate_production_secrets.py
JWT_SECRET_KEY=
SECRET_ENCRYPTION_KEY=

# --- Mandatory Production Guardrails ---
# An uncapped tenant is unbounded cost. Required in production.
MODEL_DEFAULT_SPEND_LIMIT_USD=25.0

# --- Web & CORS Settings ---
# Set CORS_ORIGINS to a JSON array of your Studio frontend origin(s). Never use "*".
CORS_ORIGINS=["https://your-studio.up.railway.app"]
FRONTEND_URL=https://your-studio.up.railway.app

# Optional on Railway: if left blank, the backend auto-detects RAILWAY_PUBLIC_DOMAIN.
# Set explicitly if using a custom domain (e.g. https://api.yourdomain.com).
# PUBLIC_API_URL=https://api.yourdomain.com

# --- Model Gateway ---
# Supported providers: gemini | deepseek | moonshot | openai | openai_compatible
MODEL_PROVIDER=gemini
MODEL_ID=gemini-2.5-flash
MODEL_ALLOWED_IDS=["gemini-2.5-flash"]
MODEL_API_KEY=
# MODEL_BASE_URL=https://api.deepseek.com/v1   # Only needed for openai_compatible / deepseek

# --- Semantic Embeddings (Knowledge Retrieval) ---
# Supported providers: gemini | deterministic (offline testing only)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_API_KEY=

# --- GitHub App Connection (Optional but required for live repository import) ---
# Ensure your GitHub App's Callback & Setup URLs point to your FRONTEND_URL.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
