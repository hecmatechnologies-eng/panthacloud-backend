# Backend Environment Configuration
APP_ENV=development
APP_NAME=fussion-backend
APP_VERSION=0.1.0

# Database Configuration
# Primary: PostgreSQL (Required in production)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fussion_db

# Development Fallback (Permitted only in development/testing environments)
FALLBACK_SQLITE_URL=sqlite+aiosqlite:///./fussion.db

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]

# Model plane (B5) — one primary provider, optionally plus a failover. With no MODEL_API_KEY the
# gateway stays unconfigured and the runtime returns 503 rather than fabricating an answer.
# MODEL_PROVIDER: gemini | moonshot | openai | openrouter | openai_compatible | deepseek
# MODEL_ID must appear in MODEL_ALLOWED_IDS or startup refuses the configuration.
#   Google Gemini:
#     MODEL_PROVIDER=gemini
#     MODEL_ID=gemini-2.5-flash
#   DeepSeek (OpenAI-compatible; the base URL defaults to https://api.deepseek.com/v1):
#     MODEL_PROVIDER=deepseek
#     MODEL_ID=deepseek-chat
#     MODEL_ALLOWED_IDS=["deepseek-chat","deepseek-reasoner"]
#   Moonshot (Kimi), OpenAI-compatible:
#     MODEL_PROVIDER=moonshot
#     MODEL_ID=kimi-k2.6
#     MODEL_ALLOWED_IDS=["kimi-k2.6","kimi-k3"]
# MODEL_API_KEY=            # never commit a real key
# MODEL_BASE_URL=           # only needed for openai_compatible
#
# Failover provider. Reached only when the primary fails transiently (spent quota, 429, 5xx) after
# its retry budget; a rejected request is never replayed elsewhere. Setting MODEL_FALLBACK_API_KEY
# is the single switch that enables it. The fallback's model id replaces the caller's for that one
# call, because a model name from one vendor is meaningless to another - so the usage ledger
# records whichever provider actually answered. MODEL_FALLBACK_ALLOWED_IDS guards that
# substitution and is validated at startup, for the same reason MODEL_ALLOWED_IDS guards the rest.
#   OpenRouter, free tier (key creation needs no card):
#     MODEL_FALLBACK_PROVIDER=openrouter
#     MODEL_FALLBACK_API_KEY=sk-or-...
#     MODEL_FALLBACK_ID=openrouter/free
#     MODEL_FALLBACK_ALLOWED_IDS=["openrouter/free"]

# Secrets
# Required in production; the app refuses to start without secure values, and rejects weak or
# known-compromised ones. Leave both unset in development and a per-installation key pair is
# generated in DEV_SECRETS_FILE on first use (gitignored, never committed).
#   JWT_SECRET_KEY=            # high-entropy random string
#   SECRET_ENCRYPTION_KEY=     # a Fernet key; generate one with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DEV_SECRETS_FILE=./.dev-secrets.json

# OAuth2 Single Sign-On (Google & GitHub)
# GitHub OAuth App:
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth 2.0 Web Client:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ==============================================================================
# Production (Railway or any process manager). Set these as platform secrets —
# never in a committed file. The app refuses to start if one is missing, weak or
# known-compromised, so the first failed deploy is that contract working.
# ==============================================================================
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db    # SQLite is refused in production
# JWT_SECRET_KEY=                       # high-entropy; the leaked dev values are rejected by hash
# SECRET_ENCRYPTION_KEY=                # a Fernet key
# CORS_ORIGINS=["https://studio.example.com"]                  # the Studio's origin, never "*"
# FRONTEND_URL=https://studio.example.com
# MODEL_PROVIDER=deepseek
# MODEL_ID=deepseek-chat
# MODEL_ALLOWED_IDS=["deepseek-chat"]
# MODEL_API_KEY=sk-...
# MODEL_DEFAULT_SPEND_LIMIT_USD=25      # required in production: an uncapped tenant is unbounded cost
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=...
# GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY / GITHUB_APP_SLUG /
# GITHUB_APP_CLIENT_ID / GITHUB_APP_CLIENT_SECRET
#   — and repoint the App's Setup and Callback URLs at the *production* Studio origin.
#
# Not required to boot, but decide deliberately:
#
# WORKSPACE_BASE_DIR=./data/workspaces
#   An ephemeral filesystem clears this on every restart, which also clears the workspaces that
#   leak today (2,265 of them locally as of 2026-09-15). Attach a volume only once a retention
#   sweep exists — WORKSPACE_RETENTION_HOURS is currently enforced nowhere.
#
# PUBLIC_API_URL (frontend service, not this one) must be the API's public HTTPS origin: it is
# what the embed snippet contains and what a customer's browser loads the widget from.
