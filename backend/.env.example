# Backend Environment Configuration
APP_ENV=development
APP_NAME=fussion-backend
APP_VERSION=0.1.0

# Database Configuration
# Primary: PostgreSQL (Required in production)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fussion_db

# Development Fallback (Permitted only in development/testing environments)
FALLBACK_SQLITE_URL=sqlite+aiosqlite:///./fussion.db

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]
